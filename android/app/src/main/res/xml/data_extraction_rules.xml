<?xml version="1.0" encoding="utf-8"?>
<!--
    Las conexiones guardadas incluyen el token del agente: no se copian a la nube ni a otro
    teléfono. En un teléfono nuevo hay que volver a cargarlas.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
